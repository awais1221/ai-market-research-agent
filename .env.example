# Copy this file to .env and fill in your values. Never commit .env!
# On GitHub Actions, put the same values in Settings → Secrets and variables → Actions.

# --- AI model (any OpenAI-compatible provider) --------------------------------
# Free: Google Gemini. Get a key at https://aistudio.google.com/apikey
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=your-api-key-here
MODEL_NAME=gemini-3.5-flash-lite
# Groq:   BASE_URL=https://api.groq.com/openai/v1        MODEL_NAME=llama-3.3-70b-versatile
# Ollama: BASE_URL=http://localhost:11434/v1  API_KEY=ollama  MODEL_NAME=llama3.2

# --- Telegram (optional) -----------------------------------------------------
# 1. In Telegram, message @BotFather → /newbot → copy the token it gives you.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which changes trigger an instant alert: high | medium | low
ALERT_MIN_IMPORTANCE=high

# --- Google Sheets (optional) --------------------------------------------------
# A Google Cloud service account key (free, no billing). Either paste the whole
# JSON on one line, or give the path to the downloaded .json file.
# Share the Sheet with the service account's e-mail address (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long ID in the Sheet's URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# true = read the competitor list from the Sheet's "Competitors" tab instead of sources.yaml
SOURCES_FROM_SHEET=false

# --- Optional settings (defaults shown) -----------------------------------------
# LLM_MIN_INTERVAL=4          # seconds between AI calls (free tiers allow ~15/min)
# MAX_LLM_CALLS_PER_RUN=60    # above this, simple rule-based summaries are used
# REQUEST_DELAY=1.5           # seconds between requests to the same website
# MIN_CHANGE_CHARS=40         # smaller text changes are treated as noise
# REPORT_AFTER_FAILURES=3     # Telegram warning when a source fails this many runs in a row
# MAX_FEED_ITEMS=30
# TOP_K=6                     # chunks retrieved per question
# MIN_SCORE=0.5               # similarity below this = "no data" (no AI call)
# DATA_DIR=./data
# SOURCES_FILE=./sources.yaml
